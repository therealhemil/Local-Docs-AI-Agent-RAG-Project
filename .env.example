# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_doc_assistant?schema=public"

# Session / JWT Secret
JWT_SECRET="ai-document-assistant-super-secret-jwt-key-2026"

# Google Drive API Configuration (Optional: automatically uses simulated drive storage if omitted)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# n8n AI & RAG Webhook Integration (Optional: returns structured placeholder responses if omitted)
N8N_CHAT_WEBHOOK_URL=""
N8N_DOCUMENT_WEBHOOK_URL=""

# App URL
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Auth0 OAuth (Google + GitHub social login)
# Create a Regular Web Application at https://auth0.com
# Enable Google and GitHub social connections in your Auth0 dashboard
AUTH0_SECRET="generate-with: openssl rand -hex 32"
APP_BASE_URL="http://localhost:3000"
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID="your-auth0-client-id"
AUTH0_CLIENT_SECRET="your-auth0-client-secret"
