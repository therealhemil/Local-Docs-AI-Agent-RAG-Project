generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id                  String            @id @default(uuid())
  name                String
  email               String?           @unique
  passwordHash        String?
  authProvider        String            @default("CREDENTIALS") // "CREDENTIALS" | "GOOGLE" | "GITHUB" | "DEMO"
  avatarUrl           String?
  normalizedName      String            @unique
  googleDriveFolderId String?

  // User Tracking Details
  firstLoginAt        DateTime?         @default(now())
  lastLoginAt         DateTime?         @default(now())
  loginCount          Int               @default(1)
  lastIpAddress       String?
  lastUserAgent       String?
  lastDevice          String?
  lastBrowser         String?
  lastOs              String?
  country             String?
  city                String?
  timezone            String?
  referrer            String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  documents           Document[]
  conversations       Conversation[]
  trackingLogs        UserTrackingLog[]

  @@map("users")
}

model UserTrackingLog {
  id               String   @id @default(uuid())
  userId           String
  action           String   // "SIGNUP" | "LOGIN" | "SESSION_START"
  ipAddress        String?
  userAgent        String?
  device           String?
  browser          String?
  os               String?
  country          String?
  city             String?
  timezone         String?
  screenResolution String?
  referrer         String?
  metadata         String?  // JSON context
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("user_tracking_logs")
}

model Document {
  id                  String         @id @default(uuid())
  userId              String
  originalFileName    String
  mimeType            String?
  fileSize            BigInt?
  googleDriveFileId   String?
  googleDriveFolderId String?
  status              DocumentStatus @default(UPLOADING)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("documents")
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  sources        String?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}
